# Copy to .env and adjust. Never commit the real .env.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# SQLite by default, so the project runs with no external services.
# DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp_lite

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# Comma-separated list of allowed frontend origins. The Nuxt dev server uses
# 3001 when 3000 is already occupied.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# --- Multi-tenancy ---
DEFAULT_COMPANY=DEMO_SL